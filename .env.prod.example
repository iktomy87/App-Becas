# Plantilla para producción.
# Copiar a .env.prod y completar. NO commitear el .env.prod.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up --build -d
POSTGRES_USER=becas
POSTGRES_PASSWORD=poner_password_fuerte
POSTGRES_DB=becas_db
# Puerto público del frontend (nginx). Default: 80
FRONTEND_PORT=80
