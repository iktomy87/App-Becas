# Plantilla de variables para docker-compose.dev.yml.
# Copiar a .env y completar. NO commitear el .env.
#
#   cp .env.example .env
#
# El backend/apps las consumen vía interpolación de Compose
# (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB).
POSTGRES_USER=becas
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=becas_db
