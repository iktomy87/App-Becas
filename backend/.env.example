# Copiar a backend/.env y completar. NO commitear el .env.

# Base de datos Supabase
# Transaction pooler (runtime, puerto 6543)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexión directa (solo migraciones Prisma, puerto 5432)
DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Storage (secret key sb_secret_..., nunca con prefijo VITE_)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_STORAGE_SECRET=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=archivos

# Render no tiene salida IPv6: forzar IPv4 (aplica también a prisma migrate)
NODE_OPTIONS=--dns-result-order=ipv4first

# CORS para el frontend desplegado
CORS_ORIGIN=https://<proyecto>.vercel.app

# Cola Postgres (opcional)
QUEUE_POLL_INTERVAL_MS=1500
#QUEUE_WORKER_ENABLED=true

# Solo para correr con docker-compose local (ya no usado en producción)
POSTGRES_USER=becas
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=becas_db
